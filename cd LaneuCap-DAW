# GitHub Actions workflow to build LaneuCap DAW on Windows and produce a zip artifact
name: Windows Build

on:
  push:
    branches: [ init-juce-daw, main ]
  pull_request:
    branches: [ main ]

jobs:
  build:
    runs-on: windows-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup MSYS2 (for Git & CMake)
        uses: msys2/setup-msys2@v3
        with:
          update: true

      - name: Install CMake
        uses: jwlawson/actions-setup-cmake@v2
        with:
          cmake-version: '3.24.0'

      - name: Configure
        run: |
          mkdir build
          cd build
          cmake -G "Visual Studio 17 2022" ..

      - name: Build
        run: |
          cd build
          cmake --build . --config Release

      - name: Package
        run: |
          cd build
          $exe = Get-ChildItem -Path . -Filter "*LaneuCapDAW*.exe" -Recurse | Select-Object -First 1
          if ($exe) {
            $out = "LaneuCap-Release.zip"
            Compress-Archive -Path $exe.FullName -DestinationPath $out -Force
          }
        shell: powershell

      - name: Upload artifact
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: laneucap-windows-exe
          path: build/LaneuCap-Release.zip
"@

