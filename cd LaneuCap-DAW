# Git add/commit/push
Write-Host "Preparing git commit on branch $branch..."
# fetch current branches
git rev-parse --is-inside-work-tree > $null 2>&1
if ($LASTEXITCODE -ne 0) {
    Write-Error "Not inside a git repository. Run this script from the repo root."
    exit 1
}

git fetch origin

# create or checkout branch
$localBranches = git branch --list $branch
if (![string]::IsNullOrWhiteSpace($localBranches)) {
    git checkout $branch
} else {
    git checkout -b $branch
}

git add -A
$commitMessage = "Add mixer meters, dynamic channels, playhead/loop, piano roll editing and Windows CI"
git commit -m $commitMessage

if ($LASTEXITCODE -ne 0) {
    Write-Error "Commit failed. There may be no changes staged or git reported an error."
    exit 1
}

git push -u origin $branch
if ($LASTEXITCODE -eq 0) {
    Write-Host "Pushed branch $branch to origin. Open a PR from init-juce-daw -> main in GitHub to review."
} else {
    Write-Error "Push failed. Check your credentials and network access."
    exit 1
  }
