Write-FileContent "src/UI/PianoRoll.h" @"
#pragma once
#include <JuceHeader.h>

class PianoRollComponent : public juce::Component
{
public:
    PianoRollComponent();
    void paint(juce::Graphics& g) override;
    void resized() override;
    void mouseDown(const juce::MouseEvent& e) override;
    void mouseDrag(const juce::MouseEvent& e) override;
    void mouseUp(const juce::MouseEvent& e) override;

    struct NoteVisual { double startBeat; double duration; int midiNote; int channel; };
    juce::Array<NoteVisual> notes;

private:
    int selectedNote = -1;
    juce::Point<int> mouseDragLast;

    JUCE_DECLARE_NON_COPYABLE_WITH_LEAK_DETECTOR(PianoRollComponent)
};
"@

Write-FileContent "src/UI/PianoRoll.cpp" @"
#include ""PianoRoll.h""
#include ""../AudioEngine.h""

PianoRollComponent::PianoRollComponent()
{
}

void PianoRollComponent::paint(juce::Graphics& g)
{
    g.fillAll(juce::Colours::darkslategrey);
    g.setColour(juce::Colours::white);

    // draw grid for 16 beats and 12 notes
    int beats = 16;
    int keys = 12;
    auto r = getLocalBounds().toFloat();
    for (int b = 0; b <= beats; ++b)
    {
        float x = r.getX() + (r.getWidth() * b / beats);
        g.drawLine(x, r.getY(), x, r.getBottom(), 1.0f);
    }
    for (int k = 0; k <= keys; ++k)
    {
        float y = r.getY() + (r.getHeight() * k / keys);
        g.drawLine(r.getX(), y, r.getRight(), y, 1.0f);
    }

    // draw notes
    g.setColour(juce::Colours::orange);
    for (int i = 0; i < notes.size(); ++i)
    {
        auto& n = notes.getReference(i);
        float x = (float)(getWidth() * (n.startBeat / 16.0));
        float w = (float)(getWidth() * (n.duration / 16.0));
        float y = (float)(getHeight() * ((127 - n.midiNote) / 12.0));
        g.fillRect(x, y, w, 12);

        if (i == selectedNote)
        {
            g.setColour(juce::Colours::yellow);
            g.drawRect(x, y, w, 12, 2);
        }
    }
}

void PianoRollComponent::resized()
{
}

void PianoRollComponent::mouseDown(const juce::MouseEvent& e)
{
    // detect click on existing note
    for (int i = 0; i < notes.size(); ++i)
    {
        auto& n = notes.getReference(i);
        float x = (float)(getWidth() * (n.startBeat / 16.0));
        float w = (float)(getWidth() * (n.duration / 16.0));
        float y = (float)(getHeight() * ((127 - n.midiNote) / 12.0));
        juce::Rectangle<float> r(x, y, w, 12);
        if (r.contains((float)e.x, (float)e.y))
        {
            selectedNote = i;
            mouseDragLast = e.getPosition();
            repaint();
            if (e.mods.isRightButtonDown())
            {
                # delete on right click
                notes.remove(i);
                # also remove from engine sequence - simple linear search
                auto seq = AudioEngine::getInstance();
                juce::Array<int> toRemove;
                for (int si = 0; si < seq->sequence.size(); ++si)
                {
                    auto& ev = seq->sequence.getReference(si);
                    if (ev.midiNote == n.midiNote && ev.startBeat == n.startBeat)
                    {
                        toRemove.add(si);
                        break;
                    }
                }
                for (int ri = toRemove.size()-1; ri -ge 0; --ri)
                    seq->sequence.remove(toRemove[ri]);

                selectedNote = -1;
                repaint();
            }
            return;
        }
    }

    # convert mouse x to beat, y to midi note
    double beat = (double)e.x / (double)getWidth() * 16.0;
    int midi = 72 - (int)((double)e.y / (double)getHeight() * 12.0);
    if (midi < 0) midi = 0; if (midi > 127) midi = 127;

    NoteVisual nv;
    nv.startBeat = std::floor(beat);
    nv.duration = 1.0;
    nv.midiNote = midi;
    nv.channel = 0; # default channel 0
    notes.add(nv);

    # add to AudioEngine sequence
    AudioEngine::NoteEvent ev;
    ev.channel = nv.channel;
    ev.midiNote = nv.midiNote;
    ev.velocity = 100;
    ev.startBeat = nv.startBeat;
    ev.durationBeats = nv.duration;
    ev.onSent = ev.offSent = false;
    AudioEngine::getInstance()->addNoteEvent(ev);

    repaint();
}

void PianoRollComponent::mouseDrag(const juce::MouseEvent& e)
{
    if (selectedNote >= 0 && selectedNote < notes.size())
    {
        auto delta = e.getPosition() - mouseDragLast;
        double beatDelta = (double)delta.x / (double)getWidth() * 16.0;
        int noteDelta = -(int)((double)delta.y / (double)getHeight() * 12.0);

        auto& n = notes.getReference(selectedNote);
        n.startBeat += beatDelta;
        n.midiNote += noteDelta;
        if (n.startBeat < 0) n.startBeat = 0;
        if (n.midiNote < 0) n.midiNote = 0;
        if (n.midiNote > 127) n.midiNote = 127;

        # update corresponding sequence event (simple match by original characteristics)
        auto seq = AudioEngine::getInstance();
        for (int si = 0; si < seq->sequence.size(); ++si)
        {
            auto& ev = seq->sequence.getReference(si);
            if (ev.midiNote == n.midiNote && std::abs(ev.startBeat - n.startBeat - beatDelta) < 0.001)
            {
                ev.startBeat = n.startBeat;
                ev.midiNote = n.midiNote;
                break;
            }
        }

        mouseDragLast = e.getPosition();
        repaint();
    }
}

void PianoRollComponent::mouseUp(const juce::MouseEvent& e)
{
    selectedNote = -1;
}
